{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api?__vercel_path=/api/$1" },
    { "source": "/robots.txt", "destination": "/api?__vercel_path=/robots.txt" },
    { "source": "/sitemap.xml", "destination": "/api?__vercel_path=/sitemap.xml" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}